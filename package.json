{
  "name": "q-pros-manual-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Record browser interactions and export manual test guides as Word/PDF documents. Chrome MV3 extension by Hussein Zahran.",
  "license": "MIT",
  "homepage": "https://github.com/husseinzahran7/Q-PROS-Manual-Guide#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/husseinzahran7/Q-PROS-Manual-Guide.git"
  },
  "bugs": {
    "url": "https://github.com/husseinzahran7/Q-PROS-Manual-Guide/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && cross-env BUILD_TARGET=content vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dexie": "^4.0.11",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
